# Copy this file to .env before starting the stack.
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:16
FORGEJO_POSTGRES_IMAGE=postgres:17-alpine

FORGEJO_APP_NAME=ZapCode Forgejo
FORGEJO_DOMAIN=server
FORGEJO_HTTP_BIND_ADDRESS=0.0.0.0
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_BIND_ADDRESS=0.0.0.0
FORGEJO_SSH_PORT=2222
FORGEJO_UID=1000
FORGEJO_GID=1000

FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD="LU(*9y0csB4P3Nk99uQ>='b=/i5*9M^Q"

# Set to false if LAN users should be allowed to create their own accounts.
FORGEJO_DISABLE_REGISTRATION=false

# Optional: outgoing mail through the existing ZapServer mail stack.
FORGEJO_MAILER_ENABLED=false
FORGEJO_MAILER_HOST=mail.zapcode.ch
FORGEJO_MAILER_PORT=587
FORGEJO_MAILER_USER=no-reply@zapcode.ch
FORGEJO_MAILER_PASSWORD=replace-me-before-enabling-mail
FORGEJO_MAILER_FROM=Forgejo <no-reply@zapcode.ch>
